        child: AnimatedBuilder(
          animation: _scale,
          builder: (context, child) => ClipRect(
            child: Align(
              alignment: Alignment.topCenter,
              heightFactor: _scale.value.clamp(0.001, 1.0),
              child: child,
            ),
          ),
          child: widget.child,
        ),
      ),
    );
  }
