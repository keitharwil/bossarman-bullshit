                    ),
                  ),
                  const SizedBox(height: 6),
                  const Text(
                    'Select whether to embed structured JSON metadata or raw SKU for handheld 1D/2D optical readers.',
                    style: TextStyle(
                      color: AppPalette.textMuted,
                      fontSize: 12,
                    ),
                  ),
                  const SizedBox(height: 12),
                  SegmentedButton<bool>(
                    segments: const [
                      ButtonSegment<bool>(
                        value: true,
