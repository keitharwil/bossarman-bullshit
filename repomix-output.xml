  List<Widget> _buildItemizedRows(PosTransaction tx) {
    // itemsSummary can be comma separated "1x Tire, 2x Oil Filter" or custom string
    final items = tx.itemsSummary.split(', ');
    if (items.isEmpty || tx.itemsSummary.trim().isEmpty) {
      return [
        _buildItemLine(
          desc: 'Items & Services Rendered',
          qty: '1',
          total: '₱${tx.totalAmount.toStringAsFixed(2)}',
        ),
      ];
    }

    return items.map((raw) {
      final trimmed = raw.trim();
      // Match pattern like "2x Part Name"
      final match = RegExp(r'^(\d+)x\s+(.+)$').firstMatch(trimmed);
      if (match != null) {
        final qty = match.group(1) ?? '1';
        final name = match.group(2) ?? trimmed;
        return _buildItemLine(desc: name, qty: qty, total: '');
      }
      return _buildItemLine(desc: trimmed, qty: '1', total: '');
    }).toList();
  }

  Widget _buildItemLine({
    required String desc,
    required String qty,
    required String total,
  }) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2.5),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Expanded(
            flex: 3,
            child: Text(
              desc,
              style: const TextStyle(
                fontFamily: 'monospace',
                fontSize: 10.5,
                color: Color(0xFF222222),
              ),
            ),
          ),
          Expanded(
            flex: 1,
            child: Text(
              qty,
              textAlign: TextAlign.center,
              style: const TextStyle(
                fontFamily: 'monospace',
                fontSize: 10.5,
                color: Color(0xFF222222),
              ),
            ),
          ),
          Expanded(
            flex: 2,
            child: Text(
              total,
              textAlign: TextAlign.right,
              style: const TextStyle(
                fontFamily: 'monospace',
                fontSize: 10.5,
                color: Color(0xFF222222),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPaymentBreakdown(PosTransaction tx) {
    switch (tx.paymentMethod) {
      case PaymentMethod.cash:
        return Column(
          children: [
            _buildReceiptRow('PAYMENT METHOD:', 'CASH'),
            _buildReceiptRow(
              'AMOUNT TENDERED:',
              '₱${tx.amountTendered.toStringAsFixed(2)}',
            ),
            _buildReceiptRow(
              'CHANGE DUE:',
              '₱${tx.changeAmount.toStringAsFixed(2)}',
              isBold: true,
            ),
          ],
        );
      case PaymentMethod.gcash:
        final last4 = (tx.gcashRef != null && tx.gcashRef!.length >= 4)
            ? tx.gcashRef!.substring(tx.gcashRef!.length - 4)
            : (tx.gcashRef ?? 'N/A');
        return Column(
          children: [
            _buildReceiptRow('PAYMENT METHOD:', 'GCASH'),
            _buildReceiptRow('GCASH REF (LAST 4):', '****$last4'),
            _buildReceiptRow(
              'AMOUNT PAID:',
              '₱${tx.totalAmount.toStringAsFixed(2)}',
              isBold: true,
            ),
          ],
        );
      case PaymentMethod.split:
        final last4 = (tx.gcashRef != null && tx.gcashRef!.length >= 4)
            ? tx.gcashRef!.substring(tx.gcashRef!.length - 4)
            : (tx.gcashRef ?? 'N/A');
        return Column(
          children: [
            _buildReceiptRow('PAYMENT METHOD:', 'SPLIT (CASH + GCASH)'),
            _buildReceiptRow(
              'CASH PORTION:',
              '₱${tx.cashAmount.toStringAsFixed(2)}',
            ),
            _buildReceiptRow(
              'CASH TENDERED:',
              '₱${tx.amountTendered.toStringAsFixed(2)}',
            ),
            _buildReceiptRow(
              'CASH CHANGE:',
              '₱${tx.changeAmount.toStringAsFixed(2)}',
            ),
            _buildReceiptRow(
              'GCASH PORTION:',
              '₱${tx.gcashAmount.toStringAsFixed(2)}',
            ),
            _buildReceiptRow('GCASH REF (LAST 4):', '****$last4'),
          ],
        );
    }
  }

  Widget _buildReceiptRow(String label, String value, {bool isBold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            label,
            style: TextStyle(
              fontFamily: 'monospace',
              fontSize: 10.5,
              fontWeight: isBold ? FontWeight.w800 : FontWeight.w500,
              color: const Color(0xFF333333),
            ),
          ),
          Flexible(
            child: Text(
              value,
              textAlign: TextAlign.right,
              style: TextStyle(
                fontFamily: 'monospace',
                fontSize: 10.5,
                fontWeight: isBold ? FontWeight.w800 : FontWeight.w600,
                color: const Color(0xFF111111),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildDashedLine() {
    return LayoutBuilder(
      builder: (context, constraints) {
        final boxWidth = constraints.constrainWidth();
        const dashWidth = 4.0;
        const dashHeight = 1.0;
        final dashCount = (boxWidth / (2 * dashWidth)).floor();
        return Flex(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          direction: Axis.horizontal,
          children: List.generate(dashCount, (_) {
            return const SizedBox(
              width: dashWidth,
              height: dashHeight,
              child: DecoratedBox(
                decoration: BoxDecoration(color: Color(0xFF888888)),
              ),
            );
          }),
        );
      },
    );
  }
}
</file>

<file path="views/shared/reservation_queue_section.dart">
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../core/theme/app_theme.dart';
import '../../core/utils/formatters.dart';
import '../../models/models.dart';
import '../../viewmodels/motohub_viewmodel.dart';
import '../checkout/checkout_screen.dart';
import 'confirm_dialog.dart';

/// Staff-facing list of active customer item reservations for the active
/// branch. Lets Cashier/Owner Confirm, Mark Ready, hand off to POS, or Cancel.
class ReservationQueueSection extends StatefulWidget {
  const ReservationQueueSection({super.key});

  @override
  State<ReservationQueueSection> createState() =>
      _ReservationQueueSectionState();
}

class _ReservationQueueSectionState extends State<ReservationQueueSection> {
  final Set<String> _busy = <String>{};

  Future<void> _run(
    String orderId,
    Future<bool> Function() action,
    String successMsg,
  ) async {
    if (_busy.contains(orderId)) return;
    setState(() => _busy.add(orderId));
    final vm = context.read<MotoHubViewModel>();
    try {
      final ok = await action();
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          backgroundColor: ok ? AppPalette.success : AppPalette.danger,
          content: Text(
            ok ? successMsg : (vm.statusMessage ?? 'Action failed.'),
          ),
        ),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          backgroundColor: AppPalette.danger,
          content: Text('Action failed: $e'),
        ),
      );
    } finally {
      if (mounted) setState(() => _busy.remove(orderId));
    }
  }

  Color _statusColor(ClickAndCollectOrder o) {
    if (o.isReady) return AppPalette.success;
    if (o.isConfirmed) return AppPalette.champagneGold;
    if (o.isCancelled || o.isExpired) return AppPalette.danger;
    if (o.isCompleted) return AppPalette.textMuted;
    return AppPalette.warning;
  }

  @override
  Widget build(BuildContext context) {
    final vm = context.watch<MotoHubViewModel>();
    final orders = vm.branchClickCollectOrders
        .where((o) => o.isPending || o.isConfirmed || o.isReady)
        .toList();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          'Customer Item Reservations (${orders.length})',
          style: const TextStyle(
            color: AppPalette.textHigh,
            fontSize: 17,
            fontWeight: FontWeight.w800,
          ),
        ),
        const SizedBox(height: 4),
        const Text(
          'Confirm, prepare, and hand off reserved items to POS for pickup.',
          style: TextStyle(color: AppPalette.textMuted, fontSize: 12.5),
        ),
        const SizedBox(height: 12),
        M3ECardList(
          itemCount: orders.length,
          outerRadius: 24,
          innerRadius: 6,
          gap: 4,
          variant: M3ECardVariant.filled,
          color: AppPalette.mantle,
          border: const BorderSide(color: AppPalette.surface0),
          padding: const EdgeInsets.all(14),
          emptyBuilder: const MotoHubEmptyState(
            icon: Icons.inventory_2_outlined,
            title: 'No Active Reservations',
            subtitle:
                'Customer item reservations for this branch will appear here.',
          ),
          itemBuilder: (context, index) {
            final order = orders[index];
            final color = _statusColor(order);
            final busy = _busy.contains(order.id);
            return Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Expanded(
                      child: Text(
                        '${order.id} • ${order.quantity}x ${order.partName}',
                        style: const TextStyle(
                          color: AppPalette.textHigh,
                          fontSize: 14.5,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                    Container(
                      padding: const EdgeInsets.symmetric(
                          horizontal: 8, vertical: 3),
                      decoration: BoxDecoration(
                        color: color.withValues(alpha: 0.16),
                        borderRadius: BorderRadius.circular(8),
                      ),
                      child: Text(
                        order.status,
                        style: TextStyle(
                          color: color,
                          fontSize: 11,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 4),
                Text(
                  'Customer: ${order.customerName} (${order.customerPhone}) • ${AppFormatters.currency(order.totalAmount)}',
                  style: const TextStyle(
                    color: AppPalette.textMuted,
                    fontSize: 12,
                  ),
                ),
                const SizedBox(height: 10),
                if (busy)
                  const LinearProgressIndicator(minHeight: 3)
                else
                  Wrap(
                    spacing: 8,
                    runSpacing: 6,
                    children: [
                      if (order.canStaffConfirm)
                        M3EButton.filled(
                          size: M3EButtonSize.xs,
                          onPressed: () => _run(
                            order.id,
                            () => vm.confirmClickAndCollectOrder(order.id),
                            'Confirmed reservation ${order.id}.',
                          ),
                          icon: const Icon(Icons.check_circle_outline_rounded,
                              size: 16),
                          child: const Text('Confirm'),
                        ),
                      if (order.canStaffMarkReady)
                        M3EButton.filled(
                          size: M3EButtonSize.xs,
                          onPressed: () => _run(
                            order.id,
                            () => vm.markReadyClickAndCollectOrder(order.id),
                            'Reservation ${order.id} is Ready for Pickup.',
                          ),
                          icon: const Icon(Icons.shopping_bag_outlined,
                              size: 16),
                          child: const Text('Mark Ready'),
                        ),
                      if (order.canStaffComplete)
                        M3EButton.filled(
                          size: M3EButtonSize.xs,
                          onPressed: () {
                            final ok = vm.handoffReservationToPos(order);
                            if (!ok) {
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(
                                  backgroundColor: AppPalette.danger,
                                  content: Text(vm.statusMessage ??
                                      'Could not hand off to POS.'),
                                ),
                              );
                              return;
                            }
                            CheckoutScreen.push(context);
                          },
                          icon: const Icon(Icons.point_of_sale_rounded,
                              size: 16),
                          child: const Text('Pickup via POS'),
                        ),
                      M3EButton.tonal(
                        size: M3EButtonSize.xs,
                        onPressed: () async {
                          final confirmed = await showConfirmDialog(
                            context,
                            title: 'Cancel Reservation?',
                            message:
                                'Cancel reservation ${order.id} for ${order.customerName}? The held stock will be released.',
                            confirmLabel: 'Cancel Reservation',
                            destructive: true,
                          );
                          if (!confirmed || !mounted) return;
                          await _run(
                            order.id,
                            () => vm.cancelClickAndCollectOrder(order.id),
                            'Cancelled reservation ${order.id}.',
                          );
                        },
                        icon: const Icon(Icons.close_rounded,
                            size: 16, color: AppPalette.danger),
                        child: const Text('Cancel',
                            style: TextStyle(color: AppPalette.danger)),
                      ),
                    ],
                  ),
              ],
            );
          },
        ),
      ],
    );
  }
}
