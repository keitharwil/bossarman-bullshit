        const SizedBox(height: 4),
        const Text(
          'One-tap atomic checkout combining mechanic-locked parts + labor fees.',
          style: TextStyle(color: AppPalette.textMuted, fontSize: 12.5),
        ),
        const SizedBox(height: 14),
        M3ECardList(
          itemCount: queueList.length,
          outerRadius: 24,
          innerRadius: 6,
