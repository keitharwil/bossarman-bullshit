                  ),
                  Text(
                    AppFormatters.currency(change.abs()),
                    style: TextStyle(
                      color: change >= 0 ? AppPalette.success : AppPalette.danger,
                      fontWeight: FontWeight.w900,
                      fontSize: 16,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
