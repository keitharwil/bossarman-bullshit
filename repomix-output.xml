                    .toList(),
                onChanged: (v) {
                  if (v != null) setState(() => _selectedMechanic = v);
                },
              ),
              const SizedBox(height: 12),

              TextFormField(
                controller: _issueCtrl,
                maxLines: 2,
                validator: (v) =>
                    AppValidators.requiredField(v, 'Service notes / symptoms'),
                decoration: const InputDecoration(
                  labelText: 'Motorcycle Symptoms / Requested Work',
                  hintText: 'Describe the issue or requested service...',
                  alignLabelWithHint: true,
                ),
              ),
              const SizedBox(height: 12),

              Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                decoration: BoxDecoration(
                  color: AppPalette.crust,
                  borderRadius: BorderRadius.circular(12),
