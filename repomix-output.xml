            _safeNonNegativeDouble(map['gcashVaultCollections']),
        cashoutOutflows: _safeNonNegativeDouble(
            map['cashoutOutflows'] ?? map['pettyCashOutflows']),
        totalGrossRevenue: _safeNonNegativeDouble(map['totalGrossRevenue']),
