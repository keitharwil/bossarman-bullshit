            '${job.bikeModel} (${job.plateNumber}) assigned to ${job.assignedMechanic} at ${branch.shortName}.',
        category: 'job_order',
        branch: branch,
      );

      _enqueueIfOffline('JOB_CREATE', '${job.id} (${job.plateNumber})');
      _setViewState(
        ViewState.success,
        'Created Job Order ${job.id} for ${job.bikeModel} (${job.plateNumber}).',
