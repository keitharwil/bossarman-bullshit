      );

      // Also update local staff account password if present
      final sIdx = _staffList.indexWhere(
        (s) => s.email.toLowerCase() == email.trim().toLowerCase(),
      );
      if (sIdx >= 0) {
        final existing = _staffList[sIdx];
        final updated = StaffAccount(
          id: existing.id,
          firstName: existing.firstName,
          lastName: existing.lastName,
          username: existing.username,
          email: existing.email,
          password: newPassword,
          role: existing.role,
          assignedBranch: existing.assignedBranch,
          shiftStatus: existing.shiftStatus,
          coveredByStaff: existing.coveredByStaff,
          authProvider: existing.authProvider,
          fcmToken: existing.fcmToken,
          createdAt: existing.createdAt,
        );
        _staffList[sIdx] = updated;
        await _db.saveStaff(updated);
      }

      _setViewState(ViewState.success, 'Password successfully reset! Please log in.');
      return true;
    } catch (e) {
