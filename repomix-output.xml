  void _openGCashCheckout(BuildContext context, MotoHubViewModel vm) {
    final refCtrl = TextEditingController();
    bool attachProof = false;
    String? errorText;

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: AppPalette.mantle,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (bottomSheetCtx) {
        return StatefulBuilder(
          builder: (ctx, setModalState) {
            return Padding(
              padding: EdgeInsets.only(
                left: 20,
                right: 20,
                top: 20,
                bottom: MediaQuery.of(ctx).viewInsets.bottom + 20,
              ),
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Row(
                          children: [
                            Icon(
                              Icons.qr_code_2_rounded,
                              color: Color(0xFF007DFE),
                              size: 24,
                            ),
                            SizedBox(width: 8),
                            Text(
                              'GCash Merchant Checkout',
                              style: TextStyle(
                                color: AppPalette.textHigh,
                                fontSize: 17,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ],
                        ),
                        IconButton(
                          icon: const Icon(Icons.close_rounded),
                          onPressed: () => Navigator.of(bottomSheetCtx).pop(),
                        ),
                      ],
                    ),
                    const Divider(height: 16),
                    Text(
                      'Total Due: ${AppFormatters.currency(vm.cartTotal)}',
                      textAlign: TextAlign.center,
                      style: const TextStyle(
                        color: AppPalette.champagneGold,
                        fontSize: 22,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                    const SizedBox(height: 12),
                    // GCash QR Code Box
                    Center(
                      child: Container(
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(
                          color: Colors.white,
                          borderRadius: BorderRadius.circular(16),
                          border: Border.all(
                            color: const Color(0xFF007DFE),
                            width: 2,
                          ),
                        ),
                        child: QrImageView(
                          data:
                              '00020101021226480012com.gcash.qr012409178886686520459995303608540${vm.cartTotal.toStringAsFixed(2)}5802PH5918BossArman MotoHub6009Sta Cruz',
                          version: QrVersions.auto,
                          size: 160,
                        ),
                      ),
                    ),
                    const SizedBox(height: 12),
                    // Direct GCash App Launcher Button
                    OutlinedButton.icon(
                      style: OutlinedButton.styleFrom(
                        foregroundColor: const Color(0xFF007DFE),
                        side: const BorderSide(color: Color(0xFF007DFE)),
                        padding: const EdgeInsets.symmetric(vertical: 11),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(12),
                        ),
                      ),
                      icon: const Icon(Icons.open_in_new_rounded, size: 18),
                      label: const Text(
                        'Launch GCash App Directly (gcash://)',
                        style: TextStyle(fontWeight: FontWeight.w700),
                      ),
                      onPressed: () async {
                        final gcashUri = Uri.parse('gcash://');
                        try {
                          final launched = await launchUrl(
                            gcashUri,
                            mode: LaunchMode.externalApplication,
                          );
                          if (!launched) {
                            await launchUrl(
                              Uri.parse('https://m.gcash.com/'),
                              mode: LaunchMode.externalApplication,
                            );
                          }
                        } catch (_) {
                          await launchUrl(
                            Uri.parse('https://m.gcash.com/'),
                            mode: LaunchMode.externalApplication,
                          );
                        }
                      },
                    ),
                    const SizedBox(height: 16),
                    // Reference Number Input Field (Last 4 Digits)
                    TextField(
                      controller: refCtrl,
                      keyboardType: TextInputType.number,
                      maxLength: 4,
                      inputFormatters: [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(4),
                      ],
                      onChanged: (val) {
                        if (errorText != null) {
                          setModalState(() => errorText = null);
                        }
                      },
                      decoration: InputDecoration(
                        labelText: 'Last 4 Digits of GCash Ref # (Required)',
                        hintText: 'e.g. 4819',
                        prefixIcon: const Icon(Icons.pin_rounded),
                        errorText: errorText,
                      ),
                    ),
                    // Optional Proof Attachment Toggle
                    SwitchListTile(
                      contentPadding: EdgeInsets.zero,
                      activeThumbColor: const Color(0xFF007DFE),
                      title: const Text(
                        'Attach GCash Payment Screenshot',
                        style: TextStyle(fontSize: 13, color: AppPalette.textHigh),
                      ),
                      subtitle: const Text(
                        'Flags transaction with digital proof',
                        style: TextStyle(fontSize: 11, color: AppPalette.textMuted),
                      ),
                      value: attachProof,
                      onChanged: (val) {
                        setModalState(() => attachProof = val);
                      },
                    ),
                    const SizedBox(height: 12),
                    ElevatedButton(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF007DFE),
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(14),
                        ),
                      ),
                      onPressed: () async {
                        final ref = refCtrl.text.trim();
                        if (ref.length != 4 || !RegExp(r'^\d{4}$').hasMatch(ref)) {
                          setModalState(() {
                            errorText = 'Enter exactly 4 digits from the GCash SMS/receipt';
                          });
                          return;
                        }

                        final tx = await vm.processRetailCheckout(
                          paymentMethod: PaymentMethod.gcash,
                          amountTendered: vm.cartTotal,
                          gcashAmount: vm.cartTotal,
                          gcashRef: ref,
                          gcashProofUrl: attachProof ? 'gcash_proof_$ref.png' : null,
                        );

                        if (!context.mounted) return;
                        if (tx != null) {
                          Navigator.of(bottomSheetCtx).pop(); // Close checkout sheet
                          Navigator.of(context).pop(); // Close scanner sheet
                          ReceiptPreviewModal.show(context, tx);
                        } else {
                          ScaffoldMessenger.of(context).showSnackBar(
                            SnackBar(
                              backgroundColor: AppPalette.danger,
                              content: Text(
                                vm.statusMessage ?? 'GCash checkout failed.',
                              ),
                            ),
                          );
                        }
                      },
                      child: const Text(
                        'Confirm GCash Verification & Print Receipt',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }

  void _openCashCheckout(BuildContext context, MotoHubViewModel vm) {
    final total = vm.cartTotal;
    final tenderCtrl = TextEditingController(text: total.toStringAsFixed(0));
    double tendered = total;

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: AppPalette.mantle,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (bottomSheetCtx) {
        return StatefulBuilder(
          builder: (ctx, setModalState) {
            final change = tendered - total;
            final isSufficient = change >= 0;

            void applyShortcut(double amount) {
              setModalState(() {
                tendered = amount;
                tenderCtrl.text = amount.toStringAsFixed(0);
              });
            }

            return Padding(
              padding: EdgeInsets.only(
                left: 20,
                right: 20,
                top: 20,
                bottom: MediaQuery.of(ctx).viewInsets.bottom + 20,
              ),
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Row(
                          children: [
                            Icon(
                              Icons.payments_outlined,
                              color: AppPalette.champagneGold,
                              size: 24,
                            ),
                            SizedBox(width: 8),
                            Text(
                              'Cash Tender Calculator',
                              style: TextStyle(
                                color: AppPalette.textHigh,
                                fontSize: 17,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ],
                        ),
                        IconButton(
                          icon: const Icon(Icons.close_rounded),
                          onPressed: () => Navigator.of(bottomSheetCtx).pop(),
                        ),
                      ],
                    ),
                    const Divider(height: 16),
                    Text(
                      'Total Due: ${AppFormatters.currency(total)}',
                      textAlign: TextAlign.center,
                      style: const TextStyle(
                        color: AppPalette.champagneGold,
                        fontSize: 22,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                    const SizedBox(height: 16),
                    TextField(
                      controller: tenderCtrl,
                      keyboardType: const TextInputType.numberWithOptions(decimal: true),
                      autofocus: true,
                      decoration: const InputDecoration(
                        labelText: 'Cash Tendered Amount (₱)',
                        prefixIcon: Icon(Icons.money_rounded),
                      ),
                      onChanged: (val) {
                        setModalState(() {
                          tendered = double.tryParse(val) ?? 0.0;
                        });
                      },
                    ),
                    const SizedBox(height: 10),
                    // Quick Cash Tender Increment Chips
                    Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: [
                        ActionChip(
                          label: const Text('Exact'),
                          onPressed: () => applyShortcut(total),
                        ),
                        ActionChip(
                          label: const Text('+₱50'),
                          onPressed: () => applyShortcut(tendered + 50),
                        ),
                        ActionChip(
                          label: const Text('+₱100'),
                          onPressed: () => applyShortcut(tendered + 100),
                        ),
                        ActionChip(
                          label: const Text('+₱500'),
                          onPressed: () => applyShortcut(tendered + 500),
                        ),
                        ActionChip(
                          label: const Text('+₱1,000'),
                          onPressed: () => applyShortcut(tendered + 1000),
                        ),
                      ],
                    ),
                    const SizedBox(height: 16),
                    // Auto-Calculated Change or Warning
                    Container(
                      padding: const EdgeInsets.all(14),
                      decoration: BoxDecoration(
                        color: isSufficient
                            ? AppPalette.success.withValues(alpha: 0.12)
                            : AppPalette.danger.withValues(alpha: 0.12),
                        borderRadius: BorderRadius.circular(14),
                        border: Border.all(
                          color: isSufficient ? AppPalette.success : AppPalette.danger,
                        ),
                      ),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          Text(
                            isSufficient ? 'Change Due:' : 'Insufficient Cash:',
                            style: TextStyle(
                              color: isSufficient
                                  ? AppPalette.success
                                  : AppPalette.danger,
                              fontWeight: FontWeight.w700,
                              fontSize: 14,
                            ),
                          ),
                          Text(
                            isSufficient
                                ? AppFormatters.currency(change)
                                : '-${AppFormatters.currency(change.abs())}',
                            style: TextStyle(
                              color: isSufficient
                                  ? AppPalette.success
                                  : AppPalette.danger,
                              fontWeight: FontWeight.w900,
                              fontSize: 18,
                            ),
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(height: 18),
                    ElevatedButton(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: AppPalette.champagneGold,
                        foregroundColor: AppPalette.crust,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(14),
                        ),
                      ),
                      onPressed: isSufficient
                          ? () async {
                              final tx = await vm.processRetailCheckout(
                                paymentMethod: PaymentMethod.cash,
                                amountTendered: tendered,
                                cashAmount: total,
                              );

                              if (!context.mounted) return;
                              if (tx != null) {
                                Navigator.of(bottomSheetCtx).pop(); // Close checkout sheet
                                Navigator.of(context).pop(); // Close scanner sheet
                                ReceiptPreviewModal.show(context, tx);
                              } else {
                                ScaffoldMessenger.of(context).showSnackBar(
                                  SnackBar(
                                    backgroundColor: AppPalette.danger,
                                    content: Text(
                                      vm.statusMessage ?? 'Cash checkout failed.',
                                    ),
                                  ),
                                );
                              }
                            }
                          : null,
                      child: const Text(
                        'Complete Cash Tender & Print Receipt',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }

  void _openSplitCheckout(BuildContext context, MotoHubViewModel vm) {
    final total = vm.cartTotal;
    final half = (total / 2).roundToDouble();
    final cashCtrl = TextEditingController(text: half.toStringAsFixed(0));
    final gcashCtrl = TextEditingController(text: (total - half).toStringAsFixed(0));
    final cashTenderCtrl = TextEditingController(text: half.toStringAsFixed(0));
    final gcashRefCtrl = TextEditingController();

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: AppPalette.mantle,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (bottomSheetCtx) {
        return StatefulBuilder(
          builder: (ctx, setModalState) {
            final cashPortion = double.tryParse(cashCtrl.text) ?? 0.0;
            final gcashPortion = double.tryParse(gcashCtrl.text) ?? 0.0;
            final cashTendered = double.tryParse(cashTenderCtrl.text) ?? cashPortion;
            final cashChange = cashTendered - cashPortion;

            final totalPortions = cashPortion + gcashPortion;
            final isSplitSumValid = (totalPortions - total).abs() < 0.05;
            final isTenderValid = cashChange >= 0;
            final isGcashRefValid = RegExp(r'^\d{4}$').hasMatch(gcashRefCtrl.text.trim());
            final canSubmit = isSplitSumValid && isTenderValid && isGcashRefValid;

            return Padding(
              padding: EdgeInsets.only(
                left: 20,
                right: 20,
                top: 20,
                bottom: MediaQuery.of(ctx).viewInsets.bottom + 20,
              ),
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Row(
                          children: [
                            Icon(
                              Icons.call_split_rounded,
                              color: AppPalette.champagneGold,
                              size: 24,
                            ),
                            SizedBox(width: 8),
                            Text(
                              'Split Payment (Cash + GCash)',
                              style: TextStyle(
                                color: AppPalette.textHigh,
                                fontSize: 17,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ],
                        ),
                        IconButton(
                          icon: const Icon(Icons.close_rounded),
                          onPressed: () => Navigator.of(bottomSheetCtx).pop(),
                        ),
                      ],
                    ),
                    const Divider(height: 16),
                    Text(
                      'Total Due: ${AppFormatters.currency(total)}',
                      textAlign: TextAlign.center,
                      style: const TextStyle(
                        color: AppPalette.champagneGold,
                        fontSize: 22,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                    const SizedBox(height: 14),
                    // Quick Split Buttons
                    Row(
                      children: [
                        Expanded(
                          child: OutlinedButton(
                            onPressed: () {
                              setModalState(() {
                                cashCtrl.text = half.toStringAsFixed(0);
                                gcashCtrl.text = (total - half).toStringAsFixed(0);
                                cashTenderCtrl.text = half.toStringAsFixed(0);
                              });
                            },
                            child: const Text('50 / 50 Split'),
                          ),
                        ),
                        const SizedBox(width: 10),
                        Expanded(
                          child: OutlinedButton(
                            onPressed: () {
                              final c = double.tryParse(cashCtrl.text) ?? 0.0;
                              final rem = (total - c).clamp(0.0, total);
                              setModalState(() {
                                gcashCtrl.text = rem.toStringAsFixed(0);
                              });
                            },
                            child: const Text('Auto-Balance GCash'),
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 14),
                    // Cash Portion
                    TextField(
                      controller: cashCtrl,
                      keyboardType: const TextInputType.numberWithOptions(decimal: true),
                      decoration: const InputDecoration(
                        labelText: 'Cash Amount Portion (₱)',
                        prefixIcon: Icon(Icons.money_rounded),
                      ),
                      onChanged: (_) => setModalState(() {}),
                    ),
                    const SizedBox(height: 10),
                    // Cash Tendered Field
                    TextField(
                      controller: cashTenderCtrl,
                      keyboardType: const TextInputType.numberWithOptions(decimal: true),
                      decoration: InputDecoration(
                        labelText: 'Cash Tendered by Customer (₱)',
                        prefixIcon: const Icon(Icons.payments_rounded),
                        helperText: cashChange >= 0
                            ? 'Cash Change: ${AppFormatters.currency(cashChange)}'
                            : 'Short by ${AppFormatters.currency(cashChange.abs())}',
                        helperStyle: TextStyle(
                          color: cashChange >= 0
                              ? AppPalette.success
                              : AppPalette.danger,
                        ),
                      ),
                      onChanged: (_) => setModalState(() {}),
                    ),
                    const SizedBox(height: 12),
                    // GCash Portion
                    TextField(
                      controller: gcashCtrl,
                      keyboardType: const TextInputType.numberWithOptions(decimal: true),
                      decoration: const InputDecoration(
                        labelText: 'GCash Amount Portion (₱)',
                        prefixIcon: Icon(Icons.qr_code_2_rounded, color: Color(0xFF007DFE)),
                      ),
                      onChanged: (_) => setModalState(() {}),
                    ),
                    const SizedBox(height: 10),
                    // GCash Ref Field
                    TextField(
                      controller: gcashRefCtrl,
                      keyboardType: TextInputType.number,
                      maxLength: 4,
                      inputFormatters: [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(4),
                      ],
                      decoration: const InputDecoration(
                        labelText: 'GCash Ref # (Last 4 Digits Required)',
                        hintText: 'e.g. 5921',
                        prefixIcon: Icon(Icons.pin_rounded),
                      ),
                      onChanged: (_) => setModalState(() {}),
                    ),
                    const SizedBox(height: 10),
                    // Validation Summary Card
                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: canSubmit
                            ? AppPalette.success.withValues(alpha: 0.12)
                            : AppPalette.danger.withValues(alpha: 0.12),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: canSubmit ? AppPalette.success : AppPalette.danger,
                        ),
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Row(
                            mainAxisAlignment: MainAxisAlignment.spaceBetween,
                            children: [
                              const Text('Split Portions Sum:'),
                              Text(
                                '${AppFormatters.currency(totalPortions)} / ${AppFormatters.currency(total)}',
                                style: TextStyle(
                                  fontWeight: FontWeight.bold,
                                  color: isSplitSumValid
                                      ? AppPalette.success
                                      : AppPalette.danger,
                                ),
                              ),
                            ],
                          ),
                          if (!isSplitSumValid)
                            const Text(
                              'Cash + GCash must equal the total due.',
                              style: TextStyle(
                                fontSize: 11,
                                color: AppPalette.danger,
                              ),
                            ),
                          if (!isGcashRefValid)
                            const Text(
                              'Please enter the 4-digit GCash reference number.',
                              style: TextStyle(
                                fontSize: 11,
                                color: AppPalette.danger,
                              ),
                            ),
                        ],
                      ),
                    ),
                    const SizedBox(height: 16),
                    ElevatedButton(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: AppPalette.champagneGold,
                        foregroundColor: AppPalette.crust,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(14),
                        ),
                      ),
                      onPressed: canSubmit
                          ? () async {
                              final tx = await vm.processRetailCheckout(
                                paymentMethod: PaymentMethod.split,
                                amountTendered: cashTendered,
                                cashAmount: cashPortion,
                                gcashAmount: gcashPortion,
                                gcashRef: gcashRefCtrl.text.trim(),
                              );

                              if (!context.mounted) return;
                              if (tx != null) {
                                Navigator.of(bottomSheetCtx).pop(); // Close checkout sheet
                                Navigator.of(context).pop(); // Close scanner sheet
                                ReceiptPreviewModal.show(context, tx);
                              } else {
                                ScaffoldMessenger.of(context).showSnackBar(
                                  SnackBar(
                                    backgroundColor: AppPalette.danger,
                                    content: Text(
                                      vm.statusMessage ?? 'Split checkout failed.',
                                    ),
                                  ),
                                );
                              }
                            }
                          : null,
                      child: const Text(
                        'Complete Split Checkout & Print Receipt',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }

  Widget _buildOpticalGridFallback() {
    return ColoredBox(
      color: AppPalette.crust,
      child: Opacity(
        opacity: 0.14,
        child: GridView.builder(
          physics: const NeverScrollableScrollPhysics(),
          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 8,
          ),
          itemCount: 32,
          itemBuilder: (_, index) => Container(
            decoration: BoxDecoration(
              border: Border.all(
                color: AppPalette.champagneGold,
                width: 0.5,
              ),
            ),
          ),
        ),
      ),
    );
  }
}
