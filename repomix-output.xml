                border: Border.all(
                  color: AppPalette.champagneGold.withValues(alpha: 0.25),
                ),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'QR Payload Format',
                    style: TextStyle(
                      color: AppPalette.textHigh,
