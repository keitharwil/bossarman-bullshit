            '${quantity}x ${liveItem.name} dispatched from ${fromBranch.shortName} to ${toBranch.shortName}. Awaiting [Confirm Delivery].',
        category: 'transfer',
        branch: toBranch,
        isRead: false,
        createdAt: DateTime.now(),
      );

      await _db.executeStockTransferTransaction(
        updatedItem: updatedItem,
        transfer: transfer,
