              trailing: Text(
                '${isPositive ? "+" : ""}${AppFormatters.currency(entry.amount)}',
                style: TextStyle(
                  color: isPositive ? AppPalette.success : AppPalette.danger,
                  fontWeight: FontWeight.w800,
                  fontSize: 13.5,
