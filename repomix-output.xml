                              fontWeight: FontWeight.w700,
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ],
            );
          },
        ),
      ],
    );
  }
}

class _AddStaffFormSheet extends StatefulWidget {
  const _AddStaffFormSheet();

  @override
  State<_AddStaffFormSheet> createState() => _AddStaffFormSheetState();
}

class _AddStaffFormSheetState extends State<_AddStaffFormSheet> {
  final _formKey = GlobalKey<FormState>();
  final _firstNameCtrl = TextEditingController();
  final _lastNameCtrl = TextEditingController();
  final _usernameCtrl = TextEditingController();
  final _emailCtrl = TextEditingController();
  final _passwordCtrl = TextEditingController();

  UserRole _selectedRole = UserRole.cashier;
  BranchId _selectedBranch = BranchId.patimbao;
  bool _obscurePass = true;

  @override
  void dispose() {
    _firstNameCtrl.dispose();
    _lastNameCtrl.dispose();
    _usernameCtrl.dispose();
    _emailCtrl.dispose();
    _passwordCtrl.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    if (!(_formKey.currentState?.validate() ?? false)) return;

    final vm = context.read<MotoHubViewModel>();
    final cleanEmail = _emailCtrl.text.trim();
    final cleanUsername = _usernameCtrl.text.trim().toLowerCase();

    // Check duplicate username or email first
    final duplicate = vm.staffList.any(
      (s) =>
          s.username.toLowerCase() == cleanUsername ||
          s.email.toLowerCase() == cleanEmail.toLowerCase(),
    );
    if (duplicate) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          backgroundColor: AppPalette.danger,
          content: Text(
            'Username or email is already registered to an existing account.',
            style: TextStyle(color: AppPalette.crust),
          ),
        ),
      );
      return;
    }

    // Send 6-digit OTP code to the entered staff email address
    await vm.sendAccountRegistrationOtp(cleanEmail);
    if (!mounted) return;

    _showOtpVerificationDialog(context, vm, cleanEmail);
  }

  void _showOtpVerificationDialog(
    BuildContext context,
    MotoHubViewModel vm,
    String email,
  ) {
    final otpCtrl = TextEditingController();
    String? errorText;
    int cooldownSeconds = 60;
    Timer? timer;

    showDialog<void>(
      context: context,
      barrierDismissible: false,
      builder: (dialogCtx) {
        return StatefulBuilder(
          builder: (ctx, setDialogState) {
            timer ??= Timer.periodic(const Duration(seconds: 1), (t) {
              if (cooldownSeconds > 0) {
                setDialogState(() => cooldownSeconds--);
              } else {
                t.cancel();
              }
            });

            return AlertDialog(
              backgroundColor: AppPalette.mantle,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(20),
                side: const BorderSide(color: AppPalette.surface1),
              ),
              title: const Row(
                children: [
                  Icon(Icons.mark_email_read_rounded, color: AppPalette.champagneGold),
                  SizedBox(width: 8),
                  Text(
                    'Verify Staff Email via OTP',
                    style: TextStyle(
                      color: AppPalette.textHigh,
                      fontSize: 16,
                      fontWeight: FontWeight.w800,
                    ),
                  ),
