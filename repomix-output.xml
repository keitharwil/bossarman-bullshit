  double get branchCashoutTotal {
    return currentShiftCashLedger
        .where((e) =>
            e.type == CashLedgerType.cashout ||
            e.type == CashLedgerType.pettyCashOut)
        .fold(0.0, (sum, e) => sum + e.amount.abs());
