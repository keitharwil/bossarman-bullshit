  Future<void> _migrateSchema(
    DatabaseExecutor db,
    int oldVersion,
    int newVersion,
  ) async {
    await _createTables(db);
    await _ensureColumnExists(db, 'staff_accounts', 'authProvider', "TEXT DEFAULT 'password'");
    await _ensureColumnExists(db, 'staff_accounts', 'fcmToken', 'TEXT');
    await _ensureColumnExists(db, 'staff_accounts', 'mustChangePassword', 'INTEGER NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'staff_accounts', 'photoUrl', 'TEXT');
    await _ensureColumnExists(db, 'staff_accounts', 'isDeleted', 'INTEGER NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'staff_accounts', 'deletedAt', 'TEXT');
    await _ensureColumnExists(db, 'staff_accounts', 'recoverableUntil', 'TEXT');
    await _ensureColumnExists(db, 'pos_transactions', 'cashAmount', 'REAL NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'pos_transactions', 'gcashAmount', 'REAL NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'z_readings', 'actualPhysicalCash', 'REAL NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'z_readings', 'cashDiscrepancy', 'REAL NOT NULL DEFAULT 0');
    await _ensureColumnExists(db, 'z_readings', 'cashoutOutflows', 'REAL NOT NULL DEFAULT 0');
  }

  /// Purges accounts that have been soft-deleted and whose 30-day recovery window has expired.
  Future<int> purgeExpiredDeletedAccounts() async {
    final nowIso = DateTime.now().toIso8601String();
    if (_useInMemoryFallback || _db == null) {
      final before = _memStaff.length;
      _memStaff.removeWhere(
        (s) => s.isDeleted && s.recoverableUntil != null && s.recoverableUntil!.isBefore(DateTime.now()),
      );
      return before - _memStaff.length;
    }
    return await _db!.delete(
      'staff_accounts',
      where: 'isDeleted = 1 AND recoverableUntil IS NOT NULL AND recoverableUntil < ?',
      whereArgs: [nowIso],
    );
  }

  Future<void> _ensureColumnExists(
    DatabaseExecutor db,
    String table,
    String column,
    String typeWithDefault,
  ) async {
    try {
      final info = await db.rawQuery('PRAGMA table_info($table)');
      final exists = info.any(
        (row) => (row['name'] as String?)?.toLowerCase() == column.toLowerCase(),
      );
      if (!exists) {
        await db.execute('ALTER TABLE $table ADD COLUMN $column $typeWithDefault');
      }
    } catch (e) {
      debugPrint('[LocalDatabaseService] Column check note for $table.$column: $e');
    }
  }

  /// Seeds ONLY the 3 mandatory initial administrative/staff accounts.
  /// All operational tables (`inventory_items`, `job_orders`, `pos_transactions`,
  /// `stock_transfers`, `cash_ledger`, `notifications`) start 100% empty.
  Future<void> _seedStaffOnlyIfNeeded(Database db) async {
    await db.transaction((txn) async {
      final batch = txn.batch();
      for (final staff in initialAdminAndStaffSeeds()) {
        final existing = await txn.query(
          'staff_accounts',
          where: 'username = ? OR email = ?',
          whereArgs: [staff.username, staff.email],
        );
        if (existing.isEmpty) {
          batch.insert(
            'staff_accounts',
            staff.toMap(),
            conflictAlgorithm: ConflictAlgorithm.replace,
          );
        }
      }
      await batch.commit(noResult: true);
    });
  }

  void _seedInMemoryStaffOnlyIfNeeded() {
    for (final staff in initialAdminAndStaffSeeds()) {
      if (!_memStaff.any((s) => s.username == staff.username || s.email == staff.email)) {
        _memStaff.add(staff);
      }
    }
  }

