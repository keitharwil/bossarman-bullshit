                        fontSize: 13,
                        height: 1.4,
                      ),
                    ),
                    const SizedBox(height: 10),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                      decoration: BoxDecoration(
                        color: AppPalette.surface0,
                        borderRadius: BorderRadius.circular(10),
                        border: Border.all(color: AppPalette.surface1),
                      ),
                      child: const Row(
                        children: [
                          Icon(
                            Icons.mail_outline_rounded,
                            color: AppPalette.champagneGold,
                            size: 18,
                          ),
                          SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              'Please check the staff member\'s email inbox for the 6-digit verification code.',
                              style: TextStyle(
                                color: AppPalette.textBody,
                                fontSize: 12,
                                height: 1.35,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(height: 16),
                    TextField(
                      controller: otpCtrl,
                      keyboardType: TextInputType.number,
                      maxLength: 6,
                      inputFormatters: [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(6),
                      ],
                      textAlign: TextAlign.center,
                      style: const TextStyle(
                        fontSize: 20,
                        fontWeight: FontWeight.w800,
                        letterSpacing: 6,
                      ),
                      decoration: InputDecoration(
                        labelText: 'Enter 6-Digit OTP Code',
                        hintText: '••••••',
                        errorText: errorText,
                        counterText: '',
                        prefixIcon: const Icon(Icons.security_rounded),
                      ),
                      onChanged: (val) {
                        if (errorText != null) {
                          setDialogState(() => errorText = null);
                        }
                      },
                    ),
                    const SizedBox(height: 10),
                    // Resend Timer Row
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        Text(
                          cooldownSeconds > 0
                              ? 'Resend in ${cooldownSeconds}s'
                              : 'Didn\'t receive code?',
                          style: const TextStyle(
                            color: AppPalette.textMuted,
                            fontSize: 12,
                          ),
                        ),
                        TextButton(
                          onPressed: cooldownSeconds > 0
                              ? null
                              : () async {
                                  await vm.sendAccountRegistrationOtp(email);
                                  setDialogState(() {
                                    cooldownSeconds = 60;
                                    errorText = null;
                                  });
                                  timer?.cancel();
                                  timer = Timer.periodic(
                                    const Duration(seconds: 1),
                                    (t) {
                                      if (cooldownSeconds > 0) {
                                        setDialogState(() => cooldownSeconds--);
                                      } else {
                                        t.cancel();
                                      }
                                    },
                                  );
                                },
                          child: const Text('Resend OTP'),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    timer?.cancel();
                    Navigator.of(dialogCtx).pop();
                  },
                  child: const Text('Cancel'),
                ),
                FilledButton(
                  style: FilledButton.styleFrom(
                    backgroundColor: AppPalette.champagneGold,
                    foregroundColor: AppPalette.crust,
                  ),
                  onPressed: () async {
                    final enteredOtp = otpCtrl.text.trim();
                    if (enteredOtp.length != 6) {
                      setDialogState(() {
                        errorText = 'Please enter all 6 digits of the OTP code.';
                      });
                      return;
                    }

                    final verified = vm.verifyAccountRegistrationOtp(email, enteredOtp);
                    if (!verified) {
                      setDialogState(() {
                        errorText = 'Invalid or expired 6-digit OTP code.';
                      });
                      return;
                    }

                    timer?.cancel();
                    Navigator.of(dialogCtx).pop(); // Close OTP dialog

                    // Provision and save account
                    final ok = await vm.createStaffAccount(
                      firstName: _firstNameCtrl.text,
                      lastName: _lastNameCtrl.text,
                      username: _usernameCtrl.text,
                      email: _emailCtrl.text,
                      password: _passwordCtrl.text,
                      role: _selectedRole,
                      assignedBranch: _selectedBranch,
                    );

                    if (!context.mounted) return;
                    if (ok) {
                      Navigator.of(context).pop(); // Close form sheet
                      ScaffoldMessenger.of(context).showSnackBar(
                        SnackBar(
                          backgroundColor: AppPalette.success,
                          content: Text(
                            'Email verified via OTP! Created staff account for ${_firstNameCtrl.text} ${_lastNameCtrl.text}.',
                          ),
                        ),
                      );
                    } else {
                      ScaffoldMessenger.of(context).showSnackBar(
                        SnackBar(
                          backgroundColor: AppPalette.danger,
                          content: Text(
                            vm.statusMessage ?? 'Could not create staff account',
                            style: const TextStyle(color: AppPalette.crust),
                          ),
                        ),
                      );
                    }
                  },
                  child: const Text(
                    'Verify & Create Account',
                    style: TextStyle(fontWeight: FontWeight.w800),
                  ),
                ),
              ],
            );
          },
        );
      },
    );
