                        icon: Icon(Icons.data_object_rounded, size: 16),
                      ),
                      ButtonSegment<bool>(
                        value: false,
                        label: Text('Raw SKU'),
                        icon: Icon(Icons.qr_code_2_rounded, size: 16),
                      ),
                    ],
                    selected: {_useJsonPayload},
                    onSelectionChanged: (set) {
                      setState(() {
                        _useJsonPayload = set.first;
                      });
                    },
                    style: ButtonStyle(
