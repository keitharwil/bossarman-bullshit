class CashierPosTabView extends StatelessWidget {
  const CashierPosTabView({super.key});

  void _openCheckoutModal(BuildContext context) {
    final vm = context.read<MotoHubViewModel>();
    if (vm.cart.isEmpty) return;

    PaymentMethod method = PaymentMethod.cash;
    final tenderedCtrl = TextEditingController(
      text: vm.cartTotal.toStringAsFixed(0),
    );
    final splitCashCtrl = TextEditingController(
      text: (vm.cartTotal / 2).toStringAsFixed(0),
    );
    final customerCtrl = TextEditingController(text: 'Walk-in Rider');
    final gcashRefCtrl = TextEditingController();
    final formKey = GlobalKey<FormState>();

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: AppPalette.mantle,
      builder: (ctx) {
        return StatefulBuilder(
          builder: (ctx, setModalState) {
            final total = vm.cartTotal;
            final splitCash =
                double.tryParse(splitCashCtrl.text.trim()) ?? (total / 2);
            final splitGcash = (total - splitCash).clamp(0.0, total);
            final tendered =
                double.tryParse(tenderedCtrl.text.trim()) ??
                    (method == PaymentMethod.split ? splitCash : total);

            final change = method == PaymentMethod.split
                ? (tendered - splitCash)
                : (method == PaymentMethod.cash ? (tendered - total) : 0.0);

            return Padding(
              padding: EdgeInsets.only(
                left: 20,
                right: 20,
                top: 16,
                bottom: MediaQuery.of(ctx).viewInsets.bottom + 20,
              ),
              child: SingleChildScrollView(
                child: Form(
                  key: formKey,
