  void _showDeleteAccountDialog(
    BuildContext context,
    StaffAccount user,
    MotoHubViewModel vm,
  ) {
    final textCtrl = TextEditingController();
    showDialog<void>(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppPalette.mantle,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(20),
          side: const BorderSide(color: AppPalette.danger, width: 1.5),
        ),
        title: const Row(
          children: [
            Icon(Icons.warning_amber_rounded, color: AppPalette.danger, size: 28),
            SizedBox(width: 10),
            Expanded(
              child: Text(
                'Delete Account',
                style: TextStyle(
                  color: AppPalette.textHigh,
                  fontSize: 18,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Your account will be deactivated immediately and scheduled for deletion in 30 days.',
              style: TextStyle(color: AppPalette.textHigh, fontSize: 13),
            ),
            const SizedBox(height: 8),
            const Text(
              '• You can restore your account within 30 days simply by signing back in.\n'
              '• Past transactions and repair orders will remain preserved.\n'
              '• After 30 days, your account credentials will be permanently purged.',
              style: TextStyle(color: AppPalette.textMuted, fontSize: 12),
            ),
            const SizedBox(height: 16),
            const Text(
              'To confirm, please type "DELETE" below:',
              style: TextStyle(
                color: AppPalette.danger,
                fontSize: 12.5,
                fontWeight: FontWeight.w700,
              ),
            ),
            const SizedBox(height: 8),
            TextField(
              controller: textCtrl,
              autofocus: true,
              style: const TextStyle(color: AppPalette.textHigh),
              decoration: InputDecoration(
                hintText: 'Type DELETE',
                hintStyle: const TextStyle(color: AppPalette.textMuted),
                filled: true,
                fillColor: AppPalette.surface0,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(10),
                  borderSide: const BorderSide(color: AppPalette.danger),
                ),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Cancel', style: TextStyle(color: AppPalette.textMuted)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: AppPalette.danger,
              foregroundColor: Colors.white,
            ),
            onPressed: () async {
              final input = textCtrl.text.trim();
              if (input != 'DELETE') {
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    backgroundColor: AppPalette.danger,
                    content: Text('Please type "DELETE" exactly to confirm.'),
                  ),
                );
                return;
              }
              Navigator.of(ctx).pop();
              final ok = await vm.softDeleteAccount(
                accountId: user.id,
                confirmation: 'DELETE',
              );
              if (context.mounted) {
                if (ok) {
                  Navigator.of(context).pushAndRemoveUntil(
                    MaterialPageRoute(
                      builder: (_) => const CustomerAuthScreen(),
                    ),
                    (r) => false,
                  );
                }
              }
            },
            child: const Text('Confirm Deletion', style: TextStyle(fontWeight: FontWeight.w700)),
          ),
        ],
      ),
    );
  }
}
