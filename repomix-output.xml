                      fontSize: 15,
                    ),
                  ),
                ),
                IconButton(
                  tooltip: 'Share / Export Receipt PNG',
                  icon: _isSharing
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(
                            strokeWidth: 2,
                            color: AppPalette.champagneGold,
