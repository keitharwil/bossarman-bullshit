  Future<bool> resetPasswordWithOtp({
    required String email,
    required String otp,
    required String newPassword,
  }) async {
    _setViewState(ViewState.loading);
    try {
      final verified = _firebase.verifyPasswordResetOtp(email, otp);
      if (!verified) {
        _setViewState(ViewState.error, 'Invalid or expired 6-digit OTP verification code.');
        return false;
      }
      await _firebase.resetPasswordWithOtp(
        email: email,
        otp: otp,
