<file path="views/shared/user_avatar.dart">
import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';
import 'package:provider/provider.dart';
import '../../core/models/models.dart';
import '../../core/theme/app_theme.dart';
import '../../viewmodels/motohub_viewmodel.dart';

/// Reusable User Avatar Widget for Boss Arman MotoHub.
/// Displays profile photo in strict priority:
/// 1. Uploaded custom photo (compressed base64 data URI).
/// 2. Google OAuth photo (`photoUrl` from Google sign-in).
/// 3. Initials Avatar: First letter of first name + first letter of last name.
class UserAvatar extends StatelessWidget {
  final StaffAccount? user;
  final String? photoUrl;
  final String? name;
  final double radius;
  final VoidCallback? onTap;
  final bool isEditable;
  final VoidCallback? onEditPhoto;

  const UserAvatar({
    super.key,
    this.user,
    this.photoUrl,
    this.name,
    this.radius = 24,
    this.onTap,
    this.isEditable = false,
    this.onEditPhoto,
  });

  String get _effectivePhotoUrl => (user?.photoUrl ?? photoUrl ?? '').trim();

  String get _effectiveInitials {
    if (user != null) return user!.initials;
    final n = (name ?? '').trim();
    if (n.isEmpty) return '?';
    final parts = n.split(' ').where((p) => p.isNotEmpty).toList();
    if (parts.length >= 2) {
      return '${parts[0][0]}${parts[1][0]}'.toUpperCase();
    }
    return n.substring(0, 1).toUpperCase();
  }

  ImageProvider? _resolveImageProvider(String rawUrl) {
    if (rawUrl.isEmpty) return null;
    try {
      if (rawUrl.startsWith('data:image/') || (!rawUrl.startsWith('http') && rawUrl.length > 100)) {
        final base64Data = rawUrl.contains(',') ? rawUrl.split(',').last.trim() : rawUrl.trim();
        final bytes = base64Decode(base64Data);
        return MemoryImage(bytes);
      } else if (rawUrl.startsWith('http://') || rawUrl.startsWith('https://')) {
        return NetworkImage(rawUrl);
      }
    } catch (e) {
      debugPrint('[UserAvatar] Error decoding photoUrl: $e');
    }
    return null;
  }

  @override
  Widget build(BuildContext context) {
    final photo = _effectivePhotoUrl;
    final imgProvider = _resolveImageProvider(photo);
    final initials = _effectiveInitials;

    final avatarWidget = Container(
      width: radius * 2,
      height: radius * 2,
      decoration: BoxDecoration(
        shape: BoxShape.circle,
        color: AppPalette.surface1,
        border: Border.all(
          color: AppPalette.champagneGold.withValues(alpha: 0.6),
          width: 1.5,
        ),
      ),
      child: ClipOval(
        child: imgProvider != null
            ? Image(
                image: imgProvider,
                fit: BoxFit.cover,
                width: radius * 2,
                height: radius * 2,
                errorBuilder: (context, error, stackTrace) => _buildInitials(initials),
              )
            : _buildInitials(initials),
      ),
    );

    if (!isEditable) {
      return GestureDetector(
        onTap: onTap,
        child: avatarWidget,
      );
    }

    return Stack(
      alignment: Alignment.center,
      clipBehavior: Clip.none,
      children: [
        GestureDetector(
          onTap: onTap ?? onEditPhoto ?? () => showPhotoPickerSheet(context),
          child: avatarWidget,
        ),
        Positioned(
          bottom: 0,
          right: 0,
          child: GestureDetector(
            onTap: onEditPhoto ?? () => showPhotoPickerSheet(context),
            child: Container(
              padding: EdgeInsets.all(radius * 0.14),
              decoration: BoxDecoration(
                color: AppPalette.champagneGold,
                shape: BoxShape.circle,
                border: Border.all(
                  color: AppPalette.crust,
                  width: 2,
                ),
                boxShadow: const [
                  BoxShadow(
                    color: Colors.black45,
                    blurRadius: 4,
                    offset: Offset(0, 2),
                  ),
                ],
              ),
              child: Icon(
                Icons.camera_alt_rounded,
                size: radius * 0.45,
                color: AppPalette.crust,
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildInitials(String initials) {
    return Center(
      child: Text(
        initials,
        style: TextStyle(
          color: AppPalette.champagneGold,
          fontSize: radius * 0.82,
          fontWeight: FontWeight.w900,
          letterSpacing: 0.5,
        ),
      ),
    );
  }

  /// Displays the photo options sheet (Take Photo, Pick from Gallery, Remove Photo).
  static Future<void> showPhotoPickerSheet(BuildContext context) async {
    final vm = context.read<MotoHubViewModel>();
    final user = vm.currentUser;
    if (user == null) return;

    await showModalBottomSheet<void>(
      context: context,
      backgroundColor: AppPalette.mantle,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (sheetContext) {
        return SafeArea(
          child: Padding(
            padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 16),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Center(
                  child: Container(
                    width: 40,
                    height: 4,
                    margin: const EdgeInsets.only(bottom: 16),
                    decoration: BoxDecoration(
                      color: AppPalette.surface2,
                      borderRadius: BorderRadius.circular(2),
                    ),
                  ),
                ),
                Text(
                  'Profile Photo',
                  style: TextStyle(
                    color: AppPalette.textHigh,
                    fontSize: 18,
                    fontWeight: FontWeight.w800,
                  ),
                ),
                const SizedBox(height: 6),
                Text(
                  'Upload or change your account avatar. Compressed directly to your secure profile.',
                  style: TextStyle(
                    color: AppPalette.textMuted,
                    fontSize: 12.5,
                  ),
                ),
                const SizedBox(height: 18),
                ListTile(
                  leading: Container(
                    padding: const EdgeInsets.all(8),
                    decoration: BoxDecoration(
                      color: AppPalette.surface1,
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: const Icon(Icons.camera_alt_rounded, color: AppPalette.champagneGold),
                  ),
                  title: const Text('Take Photo', style: TextStyle(color: AppPalette.textHigh, fontWeight: FontWeight.w700)),
                  subtitle: const Text('Capture with device camera', style: TextStyle(color: AppPalette.textMuted, fontSize: 12)),
                  onTap: () async {
                    Navigator.of(sheetContext).pop();
                    await _pickAndCompressImage(context, ImageSource.camera);
                  },
                ),
                ListTile(
                  leading: Container(
                    padding: const EdgeInsets.all(8),
                    decoration: BoxDecoration(
                      color: AppPalette.surface1,
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: const Icon(Icons.photo_library_rounded, color: AppPalette.champagneGold),
                  ),
                  title: const Text('Choose from Gallery', style: TextStyle(color: AppPalette.textHigh, fontWeight: FontWeight.w700)),
                  subtitle: const Text('Select an image from device storage', style: TextStyle(color: AppPalette.textMuted, fontSize: 12)),
                  onTap: () async {
                    Navigator.of(sheetContext).pop();
                    await _pickAndCompressImage(context, ImageSource.gallery);
                  },
                ),
                if (user.photoUrl != null && user.photoUrl!.isNotEmpty) ...[
                  const Divider(color: AppPalette.surface1, height: 16),
                  ListTile(
                    leading: Container(
                      padding: const EdgeInsets.all(8),
                      decoration: BoxDecoration(
                        color: AppPalette.danger.withValues(alpha: 0.15),
                        borderRadius: BorderRadius.circular(10),
                      ),
                      child: const Icon(Icons.delete_outline_rounded, color: AppPalette.danger),
                    ),
                    title: const Text('Remove Photo', style: TextStyle(color: AppPalette.danger, fontWeight: FontWeight.w700)),
                    subtitle: const Text('Revert to initials avatar', style: TextStyle(color: AppPalette.textMuted, fontSize: 12)),
                    onTap: () async {
                      Navigator.of(sheetContext).pop();
                      await vm.updateCurrentUserProfilePhoto(null);
                      if (context.mounted) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('Profile photo removed. Showing initials.')),
                        );
                      }
                    },
                  ),
                ],
              ],
            ),
          ),
        );
      },
    );
  }

  static Future<void> _pickAndCompressImage(BuildContext context, ImageSource source) async {
    final vm = context.read<MotoHubViewModel>();
    try {
      final picker = ImagePicker();
      final picked = await picker.pickImage(
        source: source,
        maxWidth: 256,
        maxHeight: 256,
        imageQuality: 85,
      );
      if (picked == null) return;

      final bytes = await picked.readAsBytes();
      if (bytes.lengthInBytes > 250 * 1024) {
        if (context.mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              backgroundColor: AppPalette.danger,
              content: Text('Selected image is too large. Please select a smaller photo.'),
            ),
          );
        }
        return;
      }

      final base64Uri = 'data:image/jpeg;base64,${base64Encode(bytes)}';
      final ok = await vm.updateCurrentUserProfilePhoto(base64Uri);
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            backgroundColor: ok ? AppPalette.success : AppPalette.danger,
            content: Text(ok ? 'Profile photo updated successfully!' : 'Failed to update profile photo.'),
          ),
        );
      }
    } catch (e) {
      debugPrint('[UserAvatar] Error picking photo: $e');
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            backgroundColor: AppPalette.danger,
            content: Text('Failed to pick photo: $e'),
          ),
        );
      }
    }
  }
}
</file>

<file path="views/login_screen.dart">
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../core/models/models.dart';
import '../core/services/firebase_service.dart';
import '../core/theme/app_theme.dart';
import '../core/utils/formatters.dart';
import '../viewmodels/motohub_viewmodel.dart';
import 'role_router_screen.dart';
import 'shared/auth_transition_screen.dart';
import 'shared/forgot_password_screen.dart';

class LoginScreen extends StatefulWidget {
  const LoginScreen({super.key});

  @override
  State<LoginScreen> createState() => _LoginScreenState();
}

class _LoginScreenState extends State<LoginScreen> {
  // Direct credentials login form ("Type and connect" + Google One-Tap)
  bool _showCredentialsForm = true;

  final _formKey = GlobalKey<FormState>();
  final _usernameController = TextEditingController();
  final _passwordController = TextEditingController();
  bool _obscurePassword = true;

  @override
  void dispose() {
    _usernameController.dispose();
    _passwordController.dispose();
    super.dispose();
  }

  Future<void> _submitLogin() async {
    if (!(_formKey.currentState?.validate() ?? false)) return;

    final vm = context.read<MotoHubViewModel>();
    try {
      final ok = await vm.login(
        _usernameController.text.trim(),
        _passwordController.text,
        customerOnly: false,
      );

      if (!mounted) return;
      if (ok) {
        final user = vm.currentUser;
        if (user != null) {
          Navigator.of(context).pushReplacement(
            AuthTransitionScreen.route(
              user: user,
              isCustomerApp: false,
              customMessage: 'Accessing Staff Terminal...',
            ),
          );
        } else {
          Navigator.of(context).pushReplacement(
            MaterialPageRoute(builder: (_) => const RoleRouterScreen()),
          );
        }
      } else {
        if (vm.statusMessage?.startsWith('ACCOUNT_DELETED_RECOVERABLE') == true) {
          _showRecoverAccountDialog();
          return;
        }
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            backgroundColor: AppPalette.surface1,
            content: Row(
              children: [
                const Icon(Icons.error_outline_rounded, color: AppPalette.danger),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    vm.statusMessage ?? 'Invalid login credentials',
                    style: const TextStyle(color: AppPalette.textHigh),
                  ),
                ),
              ],
            ),
          ),
        );
      }
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          backgroundColor: AppPalette.danger,
          content: Text(
            'Authentication error: $e',
            style: const TextStyle(color: AppPalette.crust),
          ),
        ),
      );
    }
  }

  void _showRecoverAccountDialog() {
    final vm = context.read<MotoHubViewModel>();
    final pending = vm.pendingRecoveryAccount;
    if (pending == null) return;

    showDialog<void>(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppPalette.mantle,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(20),
          side: const BorderSide(color: AppPalette.champagneGold, width: 1.5),
        ),
        title: const Row(
          children: [
            Icon(Icons.history_toggle_off_rounded, color: AppPalette.champagneGold, size: 24),
            SizedBox(width: 8),
            Expanded(
              child: Text(
                'Restore Deleted Account?',
                style: TextStyle(
                  color: AppPalette.champagneGold,
                  fontSize: 17,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ),
          ],
        ),
        content: Text(
          'Account "@${pending.username}" was previously scheduled for deletion, but remains within the 30-day recovery window. Would you like to restore this account and log in?',
          style: const TextStyle(color: AppPalette.textBody, fontSize: 13),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('Cancel', style: TextStyle(color: AppPalette.textMuted)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: AppPalette.champagneGold,
              foregroundColor: AppPalette.crust,
            ),
            onPressed: () async {
              Navigator.of(ctx).pop();
              final ok = await vm.restoreAccount(pending.id);
              if (!mounted) return;
              if (ok) {
                final loginOk = await vm.login(
                  _usernameController.text.trim(),
                  _passwordController.text,
                  customerOnly: false,
                  restoreIfDeleted: true,
                );
                if (loginOk && mounted) {
                  final user = vm.currentUser;
                  if (user != null) {
                    Navigator.of(context).pushReplacement(
                      AuthTransitionScreen.route(
                        user: user,
                        isCustomerApp: false,
                        customMessage: 'Account Restored',
                      ),
                    );
                  } else {
                    Navigator.of(context).pushReplacement(
                      MaterialPageRoute(builder: (_) => const RoleRouterScreen()),
                    );
                  }
                }
              }
            },
            child: const Text('Restore & Log In'),
          ),
        ],
      ),
    );
  }

  Future<void> _handleGoogleOneTap() async {
    final vm = context.read<MotoHubViewModel>();

    // 1. Attempt native Google One-Tap / Sign-In prompt
    try {
      final googleAccount =
          await FirebaseService.instance.promptNativeGoogleSignIn();

      if (googleAccount == null) {
        // User closed or cancelled the native Google account picker
        return;
      }

      final email = googleAccount['email'] ?? '';
      final name = googleAccount['displayName'] ?? '';
      final photoUrl = googleAccount['photoUrl'];

      final ok = await vm.signInStaffWithGoogle(
        email: email,
        displayName: name,
        photoUrl: photoUrl,
      );

      if (!mounted) return;
      if (ok) {
        final user = vm.currentUser;
        if (user != null) {
          Navigator.of(context).pushReplacement(
            AuthTransitionScreen.route(
              user: user,
              isCustomerApp: false,
              customMessage: 'Google One-Tap Verified',
            ),
          );
        } else {
          Navigator.of(context).pushReplacement(
            MaterialPageRoute(builder: (_) => const RoleRouterScreen()),
          );
        }
      } else {
        _showAccessDeniedDialog(email);
      }
      return;
    } catch (e) {
      debugPrint('[LoginScreen] Native Google Sign-In notice: $e');
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          backgroundColor: AppPalette.surface1,
          content: Row(
            children: [
              const Icon(Icons.error_outline_rounded, color: AppPalette.danger),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  'Google Sign-In failed: $e',
                  style: const TextStyle(color: AppPalette.textHigh),
                ),
              ),
            ],
          ),
        ),
      );
    }
  }

  void _showAccessDeniedDialog(String email) {
    showDialog<void>(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppPalette.mantle,
        shape: RoundedRectangleBorder(
          borderRadius: BorderRadius.circular(20),
