rules_version = '2';

// Boss Arman MotoHub - Firebase Cloud Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Chat image attachments: chat_images/{threadId}/{fileName}
    // Only authenticated Firebase sessions (staff anonymous session or customer Auth) can upload and read.
    // Uploads are limited to images under 10MB.
    match /chat_images/{threadId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny-all for unspecified root paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

